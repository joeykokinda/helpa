data: {"plan":{"appliance":"electric dryer","brand":"Whirlpool","diagnosis":"A blocked lint screen or blocked outside vent is the most common cause. Too many clothes in the drum can also stop air moving through the load.","library_id":"whirlpool-electric-dryer","library_problem":"clothes_still_damp_long_dry_time","manual_url":"https://www.whirlpool.com/content/dam/global/documents/202311/owners-manual-w11691173-revA.pdf","model_number":"WED6150PW","replacement_parts":[],"safety":["Clean the lint screen before every load.","Do not run the dryer with the lint screen loose, damaged, or missing.","If the vent inside the wall needs cleaning, have a qualified vent cleaner do it."],"steps":[{"check":"The lint screen is fully out of its slot.","details":["It is on top of the dryer, near the back."],"instruction":"Pull the lint screen straight up","motion":"pull_out","photo":-1,"show_3d":true,"target_part":"lint screen"},{"check":"You can see through the screen clearly.","details":["Do not wash it for this quick clean.","Wet lint is hard to remove."],"instruction":"Roll lint off screen with fingers","motion":"none","photo":-1,"show_3d":false,"target_part":"lint screen"},{"check":"The screen sits flat in its slot.","details":["Push until it sits flat and snug."],"instruction":"Push lint screen firmly back in","motion":"push_in","photo":-1,"show_3d":true,"target_part":"lint screen"},{"check":"The drum is only about half to three-quarters full.","details":["Clothes need room to tumble.","Dry towels separately from light clothes."],"instruction":"Take out half the load","motion":"pull_out","photo":-1,"show_3d":true,"target_part":"dryer drum"},{"check":"The knob points to Normal.","details":["Normal uses medium heat for mixed loads."],"instruction":"Turn cycle knob to Normal","motion":"none","photo":-1,"show_3d":true,"target_part":"cycle knob"},{"check":"Strong warm air blows out and the flap opens.","details":["Run the dryer 5 to 10 minutes first.","Air should feel strong, like a hair dryer on high."],"instruction":"Hold hand under outside vent hood","motion":"none","photo":-1,"show_3d":true,"target_part":"outside vent hood"}],"tools":[],"cause":"a clogged lint screen"},"type":"plan"}

data: {"rig":"dryer_top_vent","step_beats":[[{"part":"lint_screen","action":"remove","caption":"Pull lint screen out"}],[{"part":"lint","action":"clean","caption":"Roll lint off screen"}],[{"part":"lint_screen","action":"insert","caption":"Push lint screen in"}],[{"part":"dryer_door","action":"open","caption":"Open dryer door"},{"part":"dryer_drum","action":"look","caption":"Check drum half full"},{"part":"dryer_door","action":"close","caption":"Close dryer door"}],[{"part":"cycle_knob","action":"turn","caption":"Turn knob to Normal"}],[{"part":"vent_hose","action":"look","caption":"Check outside vent airflow"}]],"type":"rig"}

