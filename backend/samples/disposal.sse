data: {"plan":{"aftercare":"Feed food in slowly with cold water running, and keep spoons and bones out of the sink.","appliance":"garbage disposal","brand":"InSinkErator","diagnosis":"Something hard, like a bone, pit or spoon, is likely stuck inside and stopping the plate from turning. The unit shuts itself off to protect the motor, so clear the jam before turning it on again.","library_id":"garbage-disposal","library_problem":"jammed_and_humming","manual_url":"https://www.insinkerator.com/documents/badger-series-installation-care-use-manual-english-en-us-138440.pdf","model_number":"Badger 5","pro_visit_cost":150,"replacement_parts":[],"safety":["Turn the wall switch off before you start.","Never put fingers or hands into the disposal.","Take the jam wrench out before turning the power back on.","Use tongs, never fingers, to pull anything out."],"steps":[{"check":"The switch is off and the unit is silent.","details":["Leave it off until the last step.","Also turn the water off."],"instruction":"Turn the wall switch off","motion":"press","photo":-1,"show_3d":false,"target_part":"wall switch"},{"check":"The wrench sits in the bottom hole and does not fall out.","details":["Find the hole in the middle of the flat bottom.","Push one end of the wrench firmly in."],"instruction":"Put jam wrench into bottom center hole","motion":"push_in","photo":-1,"show_3d":true,"target_part":"center hole on the bottom"},{"check":"The wrench now turns all the way around.","details":["Keep rocking until it turns one full turn.","It may feel stiff at first, then loosen."],"instruction":"Rock jam wrench back and forth gently","motion":"none","photo":-1,"show_3d":true,"target_part":"small jam wrench"},{"check":"The wrench is out and in your hand.","details":["Never leave it in when you turn power on."],"instruction":"Pull jam wrench out again","motion":"pull_out","photo":-1,"show_3d":false,"target_part":"small jam wrench"},{"check":"You can see the stuck piece in the tongs.","details":["Shine a torch down the drain to see it.","Grip the stuck piece and lift it out."],"instruction":"Pull stuck food out with tongs","motion":"pull_out","photo":-1,"show_3d":true,"target_part":"spinning plate inside the drain"},{"check":"The red button stays in, not popped out.","details":["Wait 3 to 5 minutes first so it cools.","Press lightly until it clicks and stays in."],"instruction":"Press red reset button underneath","motion":"press","photo":-1,"show_3d":true,"target_part":"red reset button"},{"check":"The unit spins freely and water drains away.","details":["Turn cold water on first, then the switch.","Let it run a few seconds after grinding stops."],"instruction":"Run cold water and test switch","motion":"press","photo":-1,"show_3d":false,"target_part":"wall switch"}],"tools":["small jam wrench","long tongs","torch"],"cause":"something jammed in the grinder"},"type":"plan"}

data: {"rig":"garbage_disposal","step_beats":[[{"part":"wall_switch","action":"press","caption":"Press wall switch off"},{"part":"faucet_handle","action":"close","caption":"Turn cold water off"}],[{"part":"hex_socket","action":"look","caption":"Look at bottom hole"},{"part":"hex_wrench","action":"insert","caption":"Push wrench into hole"}],[{"part":"hex_wrench_turn","action":"turn","caption":"Rock wrench back forth"},{"part":"turntable","action":"turn","caption":"Loosen spinning plate free"}],[{"part":"hex_wrench","action":"remove","caption":"Pull wrench out"}],[{"part":"grinding_chamber","action":"look","caption":"Look inside grinding chamber"},{"part":"jammed_object","action":"look","caption":"Find stuck object"},{"part":"jammed_object","action":"remove","caption":"Lift stuck object out"}],[{"part":"reset_button","action":"look","caption":"Find red reset button"},{"part":"reset_button","action":"press","caption":"Press red reset button"}],[{"part":"faucet_handle","action":"open","caption":"Turn cold water on"},{"part":"wall_switch","action":"press","caption":"Press wall switch on"},{"part":"turntable","action":"turn","caption":"Spin plate freely"}]],"type":"rig"}

