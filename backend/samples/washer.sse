data: {"plan":{"appliance":"top-load washer","brand":"","diagnosis":"A kinked drain hose or an uneven, tightly packed load often stops draining and spinning. Too much soap can also slow the spin.","library_id":"whirlpool-top-load-washer","library_problem":"not_draining_wet_clothes","manual_url":"https://www.whirlpool.com/owners-center-pdp.WTW5057LW.html","model_number":"","replacement_parts":[],"safety":["Unplug the washer before moving hoses.","Wipe up spilled water to avoid slipping."],"steps":[{"check":"You can see the full drain hose behind the washer.","details":["Find it at the back of the washer.","It goes to a sink or drain pipe."],"instruction":"Look behind washer at gray drain hose.","motion":"none","photo":-1,"show_3d":true,"target_part":"Drain hose"},{"check":"The hose runs smoothly with no sharp bends.","details":["Water must flow freely through it.","Clear anything blocking the sink drain."],"instruction":"Straighten any bends or kinks in hose.","motion":"none","photo":-1,"show_3d":true,"target_part":"Drain hose"},{"check":"Only a short end of hose is in the pipe.","details":["No more than about 4.5 inches inside.","Do not tape over the drain opening."],"instruction":"Push hose only four inches into drain pipe.","motion":"push_in","photo":-1,"show_3d":true,"target_part":"Drain hose"},{"check":"Clothes sit evenly around the tub wall.","details":["Drop clothes in loose piles, not one lump.","Take some out if the tub looks stuffed."],"instruction":"Spread wet clothes evenly around tub wall.","motion":"none","photo":-1,"show_3d":true,"target_part":"Wash basket"},{"check":"The knob points to Drain and Spin.","details":["Use Rinse and Spin if that is listed instead."],"instruction":"Turn knob to Drain and Spin.","motion":"none","photo":-1,"show_3d":true,"target_part":"Cycle knob"},{"check":"Water drains out and the tub spins.","details":["Close the lid before starting."],"instruction":"Press and hold Start for three seconds.","motion":"press","photo":-1,"show_3d":true,"target_part":"Start/Pause button"}],"tools":["Old towel"],"cause":"a kinked drain hose or lopsided load"},"type":"plan"}

data: {"rig":"washer_top_load","step_beats":[[{"part":"drain_hose","action":"look","caption":"Look at drain hose"}],[{"part":"drain_hose","action":"look","caption":"Check hose for kinks"}],[{"part":"drain_hose","action":"remove","caption":"Pull hose from pipe"},{"part":"drain_hose","action":"insert","caption":"Insert hose four inches"}],[{"part":"lid","action":"open","caption":"Open the lid"},{"part":"wash_basket","action":"look","caption":"Look inside basket"},{"part":"laundry","action":"look","caption":"Spread clothes evenly"}],[{"part":"cycle_knob","action":"turn","caption":"Turn to Drain Spin"}],[{"part":"lid","action":"close","caption":"Close the lid"},{"part":"start_pause_button","action":"press","caption":"Press and hold Start"}]],"type":"rig"}

