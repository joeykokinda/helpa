data: {"plan":{"aftercare":"Check pockets before washing and leave the lid open to dry after loads.","appliance":"top-load washer","brand":"","diagnosis":"Your top-load washer is sitting full of water, so the water is not pumping out as it should. A kinked or clogged thick drain hose at the back is a common first cause to check, before suspecting the pump.","library_id":"","library_problem":"","manual_url":"https://products.geappliances.com/appliance/gea-support-search-content?contentId=23080","model_number":"","pro_visit_cost":250,"replacement_parts":[],"safety":["Unplug the washer before checking the hose at the back.","Mop up spilled water so nobody slips.","If the tub is full and the washer only hums, stop and call a pro."],"steps":[{"check":"The panel is dark and the plug is out.","details":["Wait until the tub has stopped moving."],"instruction":"Turn washer off and unplug it","motion":"none","photo":-1,"show_3d":false,"target_part":"power cord plugged into wall outlet"},{"check":"The hose runs smoothly with no sharp bend or crush.","details":["Look behind the washer without pulling it far.","Straighten any sharp bend gently by hand.","Make sure the washer is not sitting on it."],"instruction":"Check thick back hose for kinks","motion":"none","photo":-1,"show_3d":true,"target_part":"thick gray drain hose at back of washer"},{"check":"The white lid sits flat and fully closed.","details":["Older washers will not drain or spin with lid up.","Move clothes away from the edge."],"instruction":"Close the white lid fully","motion":"push_in","photo":0,"show_3d":false,"target_part":"large white open washer lid"},{"check":"You hear water pumping out, or the tub starts to empty.","details":["Plug the washer back in first.","Wait a few minutes — pauses are normal.","Do not lift the lid while it spins."],"instruction":"Run Drain and Spin cycle","motion":"press","photo":0,"show_3d":true,"target_part":"round metal tub full of water and clothes"},{"check":"The tub is empty, or much lower, with wet clothes left.","details":["Put scooped water into the bucket.","Wring clothes into the bucket to lighten them."],"instruction":"Scoop out water if tub stays full","motion":"none","photo":0,"show_3d":false,"target_part":"round metal tub full of water and clothes"},{"check":"The washer is unplugged and the tub is not left full.","details":["A full tub that only hums needs service.","Tell the pro the hose and lid were checked."],"instruction":"Unplug washer and call a pro","motion":"none","photo":-1,"show_3d":false,"target_part":"power cord plugged into wall outlet"}],"tools":["bucket","old towel","cup or small bowl"]},"type":"plan"}

