data: {"plan":{"appliance":"built-in dishwasher","brand":"Whirlpool","diagnosis":"Dirty dishes often mean water cannot spin or flow freely. A blocked spray arm or a dirty floor filter is the usual cause.","library_id":"whirlpool-dishwasher","library_problem":"dishes_not_clean","manual_url":"https://images.homedepot.ca/pdf/WDT540HAMZ_use_and_care-pdf.pdf","model_number":"WDT730HAMZ","replacement_parts":[],"safety":["Let hot dishes and water cool before reaching inside.","Keep sharp knives pointing down in the basket."],"steps":[{"check":"The arm turns in a full circle without hitting anything.","details":["It should turn all the way round.","Move any tall item that hits it."],"instruction":"Spin the middle spray arm by hand","motion":"none","photo":-1,"show_3d":true,"target_part":"middle spray arm"},{"check":"The round filter is out in your hand.","details":["Turn it a quarter turn to the left.","Pull out the bottom rack first if needed."],"instruction":"Twist the round top filter left and lift","motion":"twist_ccw","photo":-1,"show_3d":true,"target_part":"round top filter"},{"check":"You can see through the clean screen with no food on it.","details":["Lift the flat filter out too.","Use a soft brush on stuck food.","Do not use a hard scouring pad."],"instruction":"Rinse the flat bottom filter under water","motion":"rinse","photo":-1,"show_3d":false,"target_part":"flat bottom filter"},{"check":"The flat filter lies flat in the tub floor.","details":["It should sit flat with no gaps.","Check no food is left under it."],"instruction":"Push the flat bottom filter down flat","motion":"push_in","photo":-1,"show_3d":true,"target_part":"flat bottom filter"},{"check":"The round filter stays put when you try to turn it.","details":["Turn a quarter turn to the right.","It should not spin freely when locked."],"instruction":"Twist the round top filter right","motion":"twist_cw","photo":-1,"show_3d":true,"target_part":"round top filter"},{"check":"Dirty sides face the middle and nothing blocks the arms.","details":["Leave space between plates and bowls.","Keep big pans off the spray arms."],"instruction":"Face dirty sides down and inward","motion":"none","photo":-1,"show_3d":false,"target_part":"bottom rack"}],"tools":["soft brush","old toothbrush"]},"type":"plan"}

data: {"rig":"dishwasher","step_beats":[[{"part":"door","action":"open","caption":"Open the dishwasher door"},{"part":"middle_spray_arm","action":"turn","caption":"Spin middle arm full circle"}],[{"part":"bottom_rack","action":"open","caption":"Slide bottom rack out"},{"part":"round_top_filter","action":"unlock","caption":"Twist filter left quarter turn"},{"part":"round_top_filter","action":"remove","caption":"Lift round filter out"}],[{"part":"flat_bottom_filter","action":"remove","caption":"Lift flat filter out"},{"part":"flat_filter_scraps","action":"clean","caption":"Brush food off screen"}],[{"part":"flat_bottom_filter","action":"insert","caption":"Set flat filter flat"}],[{"part":"round_top_filter","action":"insert","caption":"Drop round filter in"},{"part":"round_top_filter","action":"lock","caption":"Twist filter right to lock"}],[{"part":"bottom_rack","action":"open","caption":"Pull bottom rack out"},{"part":"bottom_rack","action":"look","caption":"Face dirty sides inward"},{"part":"bottom_rack","action":"close","caption":"Slide bottom rack in"},{"part":"door","action":"close","caption":"Close dishwasher door"}]],"type":"rig"}

