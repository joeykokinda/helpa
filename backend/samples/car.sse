data: {"plan":{"aftercare":"Use 0W-20 and change oil and filter every 10,000 miles or 12 months.","appliance":"car","brand":"Toyota","diagnosis":"Your 2015 Camry 2.5L is due for routine oil and filter service. It takes 4.6 quarts of 0W-20 with a new filter, plus a fresh drain plug washer.","library_id":"","library_problem":"","manual_url":"https://assets.sipb.toyota.com/publications/en/omms-s/T-MMS-15Camry/pdf/2015_Toyota_Camry_WMG_lr.pdf","model_number":"Camry 2015 2.5L","pro_visit_cost":80,"replacement_parts":["5 quarts full synthetic 0W-20 oil (4.6 quarts used)","Toyota oil filter cartridge 04152-YZZA1","Toyota drain plug gasket 90430-12031"],"safety":["Park on flat ground, set parking brake, and chock rear wheels.","Never get under a car held only by a jack — use jack stands or ramps.","Let a hot engine cool 30 minutes; hot oil can burn.","If you cannot lift the car safely and confidently, call a pro."],"steps":[{"check":"Car is level, steady, and does not rock when pushed gently.","details":["Lift at the front jack points in the manual.","Rest it on two stands or drive onto ramps."],"instruction":"Park level, lift front, set on stands","motion":"none","photo":-1,"show_3d":false,"target_part":"front jack points under the car"},{"check":"Black round cap is off and opening is visible.","details":["The cap is on top of the black engine cover, left of center.","This lets old oil drain faster."],"instruction":"Twist off black oil cap on top","motion":"twist_ccw","photo":0,"show_3d":true,"target_part":"black round oil cap on top of engine"},{"check":"Dark oil has slowed to a slow drip.","details":["Use a 14mm wrench; turn left to loosen.","Let it drain at least 10 minutes into the pan."],"instruction":"Remove drain plug, drain oil into pan","motion":"unscrew","photo":-1,"show_3d":true,"target_part":"metal drain plug in dark pan under engine"},{"check":"New pale filter and new rubber ring are inside housing.","details":["Use the 64mm filter cup; housing turns left.","Lightly oil the new ring. Snug housing back on firmly."],"instruction":"Remove filter housing, swap cartridge and ring","motion":"twist_ccw","photo":-1,"show_3d":true,"target_part":"round black filter housing under engine"},{"check":"Plug is snug and car is back on the ground.","details":["Fit the new washer on the plug.","Torque to 30 ft-lb if you have a torque wrench."],"instruction":"Replace drain plug, lower car, add oil","motion":"screw_in","photo":0,"show_3d":false,"target_part":"black round oil cap opening on top of engine"},{"check":"Oil sits between the two marks, with no drips below.","details":["Add 4.5 quarts first through a funnel, then check.","Pull the yellow loop, wipe, reinsert, and check again."],"instruction":"Check yellow dipstick, start engine, check leaks","motion":"pull_out","photo":0,"show_3d":true,"target_part":"yellow loop dipstick in front of engine"},{"check":"Screen shows Maintenance Reset Complete and light is off.","details":["Use steering controls to open Settings on the dash screen.","Choose Maintenance Reset, then Yes."],"instruction":"Reset maintenance light in dashboard Settings","motion":"press","photo":-1,"show_3d":true,"target_part":"dashboard settings screen behind steering wheel"}],"tools":["Jack and two jack stands, or ramps","14mm wrench or socket","64mm 14-flute oil filter cup wrench","Drain pan","Funnel","Paper towels and gloves"]},"type":"plan"}

