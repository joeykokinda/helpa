data: {"rig":"car_oil_change","step_beats":[[{"part":"ramps","action":"look","caption":"Drive up, engine off"},{"part":"wheel_chocks","action":"look","caption":"Chock both rear wheels"}],[{"part":"driver_door","action":"open","caption":"Open the driver's door"},{"part":"hood_release_lever","action":"press","caption":"Pull the hood release"},{"part":"driver_door","action":"close","caption":"Close the door"},{"part":"hood","action":"open","caption":"Lift latch, raise the hood"},{"part":"prop_rod","action":"open","caption":"Prop it in the slot"},{"part":"oil_fill_cap","action":"unlock","caption":"Loosen the cap, air in"}],[{"part":"drain_pan","action":"insert","caption":"Pan under the plug"},{"part":"drain_plug","action":"unlock","caption":"14 mm wrench, turn left"},{"part":"drain_plug","action":"remove","caption":"Pull it away fast"},{"part":"old_oil","action":"clean","caption":"Let it drain out"},{"part":"drain_plug","action":"insert","caption":"New gasket, plug in"},{"part":"drain_plug","action":"lock","caption":"Snug to 27 ft-lb"}],[{"part":"oil_filter","action":"unlock","caption":"64 mm cap wrench, left"},{"part":"oil_filter","action":"remove","caption":"Lower the cap, it drips"},{"part":"oil_filter","action":"insert","caption":"New element and O-ring"},{"part":"oil_filter","action":"lock","caption":"Snug to 18 ft-lb"},{"part":"drain_pan","action":"remove","caption":"Slide the pan out"}],[{"part":"oil_fill_cap","action":"remove","caption":"Lift off the fill cap"},{"part":"new_oil","action":"turn","caption":"Pour 0W-20 slowly"},{"part":"oil_fill_cap","action":"insert","caption":"Cap back on"},{"part":"oil_fill_cap","action":"lock","caption":"Twist it tight"}],[{"part":"driver_door","action":"open","caption":"Open the driver's door"},{"part":"start_button","action":"press","caption":"Start, idle one minute"},{"part":"start_button","action":"press","caption":"Engine off"},{"part":"driver_door","action":"close","caption":"Close the door"},{"part":"drain_plug","action":"look","caption":"No drips at the plug"},{"part":"oil_filter","action":"look","caption":"None at the filter"}],[{"part":"dipstick","action":"remove","caption":"Pull the yellow loop"},{"part":"dipstick_oil","action":"clean","caption":"Wipe it clean"},{"part":"dipstick","action":"insert","caption":"Push it all the way in"},{"part":"dipstick","action":"remove","caption":"Pull it out again"},{"part":"dipstick_oil","action":"look","caption":"Oil between L and F"},{"part":"dipstick","action":"insert","caption":"Put it back"},{"part":"prop_rod","action":"close","caption":"Clip the prop rod down"},{"part":"hood","action":"close","caption":"Drop it, press it shut"}]],"type":"rig"}

