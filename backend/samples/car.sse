data: {"found":1,"photo":0,"sam":"\u003c0f\u003e0\u003c|box;x1=699;y1=443;x2=729;y2=516;w=1280;h=854|\u003e\u003c|mask;x=0;y=0;data=74,31,~!!!'O!O'#HXDPd-a`J_gUFU8qxk[#g7x*Fh#zHdRb`JlpUW@2_LYx{@.Ilt^ur[Xt\u00264!n%VbK.SkP%_Xb!8^19HuqIB#o{rn#M92o=Uoe\u0026(fYec/f0S5dq.rfatYwy*pND=W[B.G)svih'9LVNAS$Z-i5qf.h/X^DN^DV_ug3KfSR7'wafEaXRRi+]uXJx##L'cIO%a\u0026F7])o6qU3XYLFKmNj_V`o+_Zo[*9n6h='A0f..{`jtEo_(1NViQj+^wIAtd7219GIY`G/_MjSq5\u0026f68_QFhX/tdkC_U^'is*(D.z$kR8l1`*TJ6:[.8-VV@G25lGk'-V8(Evj`2#.J*XHwIF6jnu]qLfL`wt$e(^)Fm1Fwq{]F98Uh7pb\u0026\u0026otU]-RXRhJ'MJ09E_HgEg]rhuGa:ILxxM@o1vrPvxk![3LlP*v[lZq%G+@*ADtN5H14t/kM]84GRsQ9u98Lr=9gkteQU=94VlJ4.'^rp3l@uOmSmT?w4%SAj{@Gfde_*Ss^St'fp]KX*CUU11pEFC?(NyWOlS^_I*v\u0026P9@bCD(%d!9i15R+g+_E\u0026O?=%`$X59[b`-(Sh!HW84QGs2|\u003e\n","step":5,"type":"step_parts"}

data: {"rig":"car_oil_change","step_beats":[[{"part":"wheel_chocks","action":"look","caption":"Check rear wheel chocks"},{"part":"jack_point","action":"look","caption":"Locate front jack points"},{"part":"ramps","action":"look","caption":"Lift front onto stands"}],[{"part":"hood","action":"open","caption":"Open the hood"},{"part":"prop_rod","action":"open","caption":"Secure hood prop rod"},{"part":"oil_fill_cap","action":"unlock","caption":"Twist oil cap left"},{"part":"oil_fill_cap","action":"remove","caption":"Lift oil cap off"}],[{"part":"drain_pan","action":"insert","caption":"Place drain pan below"},{"part":"drain_plug","action":"unlock","caption":"Loosen drain plug left"},{"part":"drain_plug","action":"remove","caption":"Remove drain plug"},{"part":"old_oil","action":"look","caption":"Watch old oil drain"}],[{"part":"oil_filter","action":"unlock","caption":"Twist filter housing left"},{"part":"oil_filter","action":"remove","caption":"Remove old filter cartridge"},{"part":"oil_filter","action":"insert","caption":"Insert new filter cartridge"},{"part":"oil_filter","action":"lock","caption":"Tighten filter housing firmly"}],[{"part":"drain_plug","action":"insert","caption":"Fit plug with washer"},{"part":"drain_plug","action":"lock","caption":"Tighten drain plug snug"},{"part":"drain_pan","action":"remove","caption":"Remove drain pan"},{"part":"new_oil","action":"turn","caption":"Pour new oil in"}],[{"part":"oil_fill_cap","action":"insert","caption":"Refit oil fill cap"},{"part":"oil_fill_cap","action":"lock","caption":"Twist oil cap right"},{"part":"dipstick","action":"remove","caption":"Pull yellow dipstick out"},{"part":"dipstick_oil","action":"clean","caption":"Wipe oil off stick"},{"part":"dipstick","action":"insert","caption":"Reinsert dipstick fully"},{"part":"dipstick","action":"remove","caption":"Pull dipstick check level"},{"part":"dipstick_oil","action":"look","caption":"Check oil between marks"},{"part":"dipstick","action":"insert","caption":"Reinsert dipstick fully"},{"part":"start_button","action":"press","caption":"Start engine briefly"},{"part":"old_oil","action":"look","caption":"Check below for leaks"}],[{"part":"driver_door","action":"open","caption":"Open driver door"},{"part":"steering_wheel","action":"look","caption":"Face steering wheel controls"},{"part":"start_button","action":"press","caption":"Reset maintenance light"},{"part":"driver_door","action":"close","caption":"Close driver door"},{"part":"prop_rod","action":"close","caption":"Release hood prop rod"},{"part":"hood","action":"close","caption":"Close the hood"}]],"type":"rig"}

