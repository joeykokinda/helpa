data: {"type": "plan", "plan": {"brand": "", "model_number": "", "appliance": "refrigerator", "manual_url": "", "diagnosis": "The coils that release heat are probably clogged with dust, so the fridge can't cool. Cleaning them and freeing the vents usually brings the cold back.", "tools": ["Flashlight", "Vacuum with a brush tool", "Towel"], "replacement_parts": [], "safety": ["Unplug the fridge before you clean under it."], "steps": [{"instruction": "Unplug the fridge", "details": ["Pull the plug straight out of the wall."], "target_part": "power plug", "photo": -1, "motion": "pull_out", "show_3d": false, "check": "The inside light is off."}, {"instruction": "Pull off the grille at the bottom front", "details": ["It clips on, so pull gently at both ends."], "target_part": "long plastic grille at the bottom front", "photo": -1, "motion": "pull_out", "show_3d": true, "check": "The grille is off and you can see under the fridge."}, {"instruction": "Vacuum the dusty coils behind the grille", "details": ["Use the brush tool and go slowly.", "A flashlight helps you see the back."], "target_part": "dusty black coils under the fridge", "photo": -1, "motion": "none", "show_3d": true, "check": "The coils look black, not gray and fuzzy."}, {"instruction": "Clear the vents inside the freezer", "details": ["Move any food that blocks the slots on the back wall."], "target_part": "air slots on the back wall of the freezer", "photo": -1, "motion": "none", "show_3d": true, "check": "Nothing is touching the slots."}, {"instruction": "Clip the grille back and plug it in", "details": ["Wait a few hours for it to cool."], "target_part": "long plastic grille at the bottom front", "photo": -1, "motion": "push_in", "show_3d": false, "check": "The fridge hums and the light is on."}], "library_id": "", "library_problem": "", "pro_visit_cost": 150, "aftercare": "Vacuum the coils every six months."}}

