data: {"type": "plan", "plan": {"brand": "Whirlpool", "model_number": "WTW5057LW", "appliance": "top-load washer", "manual_url": "https://www.whirlpool.com/owners-center-pdp.WTW5057LW.html", "diagnosis": "A kinked drain hose or an uneven, tightly packed load often stops draining and spinning. Too much soap can also slow the spin.", "tools": ["Old towel"], "replacement_parts": [], "safety": ["Unplug the washer before moving hoses.", "Wipe up spilled water to avoid slipping."], "steps": [{"instruction": "Look behind washer at gray drain hose.", "details": ["Find it at the back of the washer.", "It goes to a sink or drain pipe."], "target_part": "Drain hose", "photo": -1, "motion": "none", "show_3d": true, "check": "You can see the full drain hose behind the washer."}, {"instruction": "Straighten any bends or kinks in hose.", "details": ["Water must flow freely through it.", "Clear anything blocking the sink drain."], "target_part": "Drain hose", "photo": -1, "motion": "none", "show_3d": true, "check": "The hose runs smoothly with no sharp bends."}, {"instruction": "Push hose only four inches into drain pipe.", "details": ["No more than about 4.5 inches inside.", "Do not tape over the drain opening."], "target_part": "Drain hose", "photo": -1, "motion": "push_in", "show_3d": true, "check": "Only a short end of hose is in the pipe."}, {"instruction": "Spread wet clothes evenly around tub wall.", "details": ["Drop clothes in loose piles, not one lump.", "Take some out if the tub looks stuffed."], "target_part": "Wash basket", "photo": -1, "motion": "none", "show_3d": true, "check": "Clothes sit evenly around the tub wall."}, {"instruction": "Turn knob to Drain and Spin.", "details": ["Use Rinse and Spin if that is listed instead."], "target_part": "Cycle knob", "photo": -1, "motion": "none", "show_3d": true, "check": "The knob points to Drain and Spin."}, {"instruction": "Press and hold Start for three seconds.", "details": ["Close the lid before starting."], "target_part": "Start/Pause button", "photo": -1, "motion": "press", "show_3d": true, "check": "Water drains out and the tub spins."}], "library_id": "whirlpool-top-load-washer", "library_problem": "not_draining_wet_clothes"}}

data: {"type": "rig", "rig": "washer_top_load", "step_beats": [[{"part": "drain_hose", "action": "look", "caption": "Look at drain hose"}], [{"part": "drain_hose", "action": "look", "caption": "Check hose for kinks"}], [{"part": "drain_hose", "action": "remove", "caption": "Pull hose from pipe"}, {"part": "drain_hose", "action": "insert", "caption": "Insert hose four inches"}], [{"part": "lid", "action": "open", "caption": "Open the lid"}, {"part": "wash_basket", "action": "look", "caption": "Look inside basket"}, {"part": "laundry", "action": "look", "caption": "Spread clothes evenly"}], [{"part": "cycle_knob", "action": "turn", "caption": "Turn to Drain Spin"}], [{"part": "lid", "action": "close", "caption": "Close the lid"}, {"part": "start_pause_button", "action": "press", "caption": "Press and hold Start"}]]}

