data: {"type": "plan", "plan": {"brand": "Toyota", "model_number": "2015 Camry 2.5L", "appliance": "mid-size sedan", "manual_url": "https://www.toyota.com/owners/resources/warranty-owners-manuals/camry/2015", "diagnosis": "Your 2015 Camry 2.5L is due for fresh oil and a new filter element. It takes 4.6 quarts of 0W-20 with the filter, and the whole job is done from under the front with a drain pan.", "tools": ["Car ramps and wheel chocks", "14 mm wrench or socket", "64 mm cap-type filter wrench", "Drain pan", "Funnel", "Gloves and rags", "Torque wrench (optional)"], "replacement_parts": ["5 quarts of SAE 0W-20 engine oil (it takes 4.6 with the filter)", "Toyota oil filter element 04152-YZZA1 with its O-rings", "Drain plug gasket, Toyota 90430-12031"], "safety": ["Never get under a car held up only by a jack. Use ramps or jack stands, and chock the rear wheels.", "Let a hot engine cool about 10 minutes; fresh-off-the-road oil can burn.", "Take the old oil and filter to an auto parts store for recycling."], "steps": [{"instruction": "Drive onto ramps, chock the wheels", "details": ["Engine off, parking brake on.", "Let a hot engine cool about 10 minutes."], "target_part": "Ramps", "photo": -1, "motion": "none", "show_3d": true, "check": "Both front wheels sit in the ramp cradles and the rear wheels are chocked."}, {"instruction": "Open the hood, loosen the fill cap", "details": ["The release is by your left knee.", "Loosening the cap lets the oil drain faster."], "target_part": "Oil fill cap", "photo": -1, "motion": "twist_ccw", "show_3d": true, "check": "The hood is propped and the fill cap is loose."}, {"instruction": "Drain the oil from the 14 mm plug", "details": ["Turn the plug left, pull it away fast.", "Let it drain until it only drips.", "Use a new gasket, tighten to 27 ft-lb."], "target_part": "Oil drain plug", "photo": -1, "motion": "unscrew", "show_3d": true, "check": "The plug is back in with a new gasket and nothing drips."}, {"instruction": "Swap the cartridge filter", "details": ["Use the drain tool from the filter box first.", "64 mm cap wrench, turn left.", "New element and O-ring, oiled. Tighten to 18 ft-lb."], "target_part": "Oil filter (cartridge)", "photo": -1, "motion": "twist_ccw", "show_3d": true, "check": "The cap is back on snug with the new element inside."}, {"instruction": "Pour in 4.4 quarts of 0W-20", "details": ["Use the funnel, go slowly.", "Hold the last bit back to check the level first."], "target_part": "Oil fill cap", "photo": -1, "motion": "none", "show_3d": true, "check": "About 4.4 quarts are in and the cap is back on tight."}, {"instruction": "Run it one minute, check for drips", "details": ["Watch the plug and the filter cap.", "Engine off, then wait 5 minutes."], "target_part": "Oil drain plug", "photo": -1, "motion": "none", "show_3d": true, "check": "No drips at the plug or the filter."}, {"instruction": "Check the dipstick, top up to F", "details": ["Wipe it, push it fully in, pull again.", "Add a little at a time if it's below F."], "target_part": "Engine oil dipstick", "photo": -1, "motion": "pull_out", "show_3d": true, "check": "The oil sits between the L and F dots."}], "library_id": "car-oil-change", "library_problem": "engine_oil_due_for_change", "pro_visit_cost": 80, "aftercare": "Reset the oil maintenance reminder (your owner's manual, Maintenance section), then check the dipstick every few fill-ups. Next change in about 10,000 miles or 12 months."}}

data: {"type": "rig", "rig": "car_oil_change", "step_beats": [[{"part": "ramps", "action": "look", "caption": "Drive up, engine off"}, {"part": "wheel_chocks", "action": "look", "caption": "Chock both rear wheels"}], [{"part": "driver_door", "action": "open", "caption": "Open the driver's door"}, {"part": "hood_release_lever", "action": "press", "caption": "Pull the hood release"}, {"part": "driver_door", "action": "close", "caption": "Close the door"}, {"part": "hood", "action": "open", "caption": "Lift latch, raise the hood"}, {"part": "prop_rod", "action": "open", "caption": "Prop it in the slot"}, {"part": "oil_fill_cap", "action": "unlock", "caption": "Loosen the cap, air in"}], [{"part": "drain_pan", "action": "insert", "caption": "Pan under the plug"}, {"part": "drain_plug", "action": "unlock", "caption": "14 mm wrench, turn left"}, {"part": "drain_plug", "action": "remove", "caption": "Pull it away fast"}, {"part": "old_oil", "action": "clean", "caption": "Let it drain out"}, {"part": "drain_plug", "action": "insert", "caption": "New gasket, plug in"}, {"part": "drain_plug", "action": "lock", "caption": "Snug to 27 ft-lb"}], [{"part": "oil_filter", "action": "unlock", "caption": "64 mm cap wrench, left"}, {"part": "oil_filter", "action": "remove", "caption": "Lower the cap, it drips"}, {"part": "oil_filter", "action": "insert", "caption": "New element and O-ring"}, {"part": "oil_filter", "action": "lock", "caption": "Snug to 18 ft-lb"}, {"part": "drain_pan", "action": "remove", "caption": "Slide the pan out"}], [{"part": "oil_fill_cap", "action": "remove", "caption": "Lift off the fill cap"}, {"part": "new_oil", "action": "turn", "caption": "Pour 0W-20 slowly"}, {"part": "oil_fill_cap", "action": "insert", "caption": "Cap back on"}, {"part": "oil_fill_cap", "action": "lock", "caption": "Twist it tight"}], [{"part": "driver_door", "action": "open", "caption": "Open the driver's door"}, {"part": "start_button", "action": "press", "caption": "Start, idle one minute"}, {"part": "start_button", "action": "press", "caption": "Engine off"}, {"part": "driver_door", "action": "close", "caption": "Close the door"}, {"part": "drain_plug", "action": "look", "caption": "No drips at the plug"}, {"part": "oil_filter", "action": "look", "caption": "None at the filter"}], [{"part": "dipstick", "action": "remove", "caption": "Pull the yellow loop"}, {"part": "dipstick_oil", "action": "clean", "caption": "Wipe it clean"}, {"part": "dipstick", "action": "insert", "caption": "Push it all the way in"}, {"part": "dipstick", "action": "remove", "caption": "Pull it out again"}, {"part": "dipstick_oil", "action": "look", "caption": "Oil between L and F"}, {"part": "dipstick", "action": "insert", "caption": "Put it back"}, {"part": "prop_rod", "action": "close", "caption": "Clip the prop rod down"}, {"part": "hood", "action": "close", "caption": "Drop it, press it shut"}]]}

