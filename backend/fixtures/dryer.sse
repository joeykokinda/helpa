data: {"text":"Got it — a dryer that takes forever is frustrating, I'll look up your Whirlpool to find the likely fix.","type":"say"}

data: {"appliance":"electric dryer","brand":"Whirlpool","model_family":"Whirlpool 7.0 cu. ft. Top Load Electric Dryer with Moisture Sensor","type":"library"}

data: {"text":"That points to a blocked lint screen or vent — I'll put together a simple step-by-step plan for you.","type":"say"}

data: {"plan":{"appliance":"electric dryer","brand":"Whirlpool","diagnosis":"A blocked lint screen or blocked outside vent is the most common cause. Too many clothes in the drum can also stop air moving through the load.","library_id":"whirlpool-electric-dryer","library_problem":"clothes_still_damp_long_dry_time","manual_url":"https://www.whirlpool.com/content/dam/global/documents/202311/owners-manual-w11691173-revA.pdf","model_number":"WED6150PW","replacement_parts":[],"safety":["Clean the lint screen before every load.","Do not run the dryer with the lint screen loose, damaged, or missing.","If the vent inside the wall needs cleaning, have a qualified vent cleaner do it."],"steps":[{"check":"The lint screen is fully out of its slot.","details":["It is on top of the dryer, near the back."],"instruction":"Pull the lint screen toward you","motion":"pull_out","photo":-1,"show_3d":true,"target_part":"lint screen"},{"check":"You can see through the screen clearly.","details":["Do not wash it for this quick clean.","Wet lint is hard to remove."],"instruction":"Roll lint off screen with fingers","motion":"none","photo":-1,"show_3d":false,"target_part":"lint screen"},{"check":"The screen sits flat in its slot.","details":["Push until it sits flat and snug."],"instruction":"Push lint screen firmly back in","motion":"push_in","photo":-1,"show_3d":true,"target_part":"lint screen"},{"check":"The drum is only about half to three-quarters full.","details":["Clothes need room to tumble.","Dry towels separately from light clothes."],"instruction":"Take out half the load","motion":"pull_out","photo":-1,"show_3d":true,"target_part":"dryer drum"},{"check":"The knob points to Normal.","details":["Normal uses medium heat for mixed loads."],"instruction":"Turn cycle knob to Normal","motion":"none","photo":-1,"show_3d":true,"target_part":"cycle knob"},{"check":"Strong warm air blows out and the flap opens.","details":["Run the dryer 5 to 10 minutes first.","Air should feel strong, like a hair dryer on high."],"instruction":"Hold hand under outside vent hood","motion":"none","photo":-1,"show_3d":true,"target_part":"outside vent hood"}],"tools":[]},"type":"plan"}

data: {"scene":{"parts":[{"color":"#f4f6f7","id":"cabinet","label":"Cabinet (see-through shell)","opacity":0.18,"position":[0,52,0],"rotation":[0,0,0],"shape":"box","size":[74,96,68]},{"color":"#eef1f3","id":"top","label":"Top panel (see-through)","opacity":0.35,"position":[0,101,0],"rotation":[0,0,0],"shape":"box","size":[74,4,68]},{"color":"#e8ecee","id":"control_panel","label":"Control panel backsplash (see-through)","opacity":0.45,"position":[0,110,-28],"rotation":[0,0,0],"shape":"box","size":[74,18,12]},{"color":"#d7dde2","id":"lint_screen","label":"Lint screen","opacity":1.0,"position":[20,106,3],"rotation":[-18,0,0],"shape":"box","size":[12,0.8,28]},{"color":"#343a40","id":"lint_screen_slot","label":"Lint screen slot","opacity":1.0,"position":[20,103.5,-16],"rotation":[0,0,0],"shape":"box","size":[14,1,22]},{"color":"#24282c","id":"cycle_knob","label":"Cycle knob","opacity":1.0,"position":[-22,110,-20],"rotation":[90,0,0],"shape":"cylinder","size":[10,5,10]},{"color":"#222629","id":"power_button","label":"Power button","opacity":1.0,"position":[2,110,-21],"rotation":[90,0,0],"shape":"cylinder","size":[4,2,4]},{"color":"#1f7a6d","id":"start_button","label":"Start / Pause button","opacity":1.0,"position":[28,110,-21],"rotation":[90,0,0],"shape":"cylinder","size":[5.5,2,5.5]},{"color":"#33383d","id":"temperature_button","label":"Temperature button (Temp)","opacity":1.0,"position":[11,110,-21],"rotation":[90,0,0],"shape":"cylinder","size":[3.5,2,3.5]},{"color":"#33383d","id":"options_button","label":"Options button (Wrinkle Shield)","opacity":1.0,"position":[19,110,-21],"rotation":[90,0,0],"shape":"cylinder","size":[3.5,2,3.5]},{"color":"#dfe6eb","id":"dryer_door","label":"Dryer door — open","opacity":0.75,"position":[43,58,20],"rotation":[90,0,-55],"shape":"cylinder","size":[52,4,52]},{"color":"#aeb8c0","id":"door_latch","label":"Door latch","opacity":1.0,"position":[24,58,34],"rotation":[0,0,0],"shape":"box","size":[3,6,2]},{"color":"#b9c4cc","id":"dryer_drum","label":"Dryer drum","opacity":0.38,"position":[0,58,2],"rotation":[90,0,0],"shape":"cylinder","size":[58,52,58]},{"color":"#f2f7fb","id":"moisture_sensor_strips","label":"Moisture sensor strips (two shiny strips)","opacity":1.0,"position":[0,35,29],"rotation":[0,0,0],"shape":"box","size":[12,5,1]},{"color":"#ffd94d","id":"drum_light_bulb","label":"Drum light bulb","opacity":1.0,"position":[14,82,-22],"rotation":[0,0,0],"shape":"sphere","size":[4,4,4]},{"color":"#cfd8de","id":"drying_rack","label":"Drying rack (inside drum)","opacity":0.9,"position":[0,44,2],"rotation":[0,0,0],"shape":"box","size":[42,2,38]},{"color":"#e3e7ea","id":"outside_vent_hood","label":"Outside vent hood","opacity":1.0,"position":[38,68,-84],"rotation":[0,0,0],"shape":"box","size":[26,20,6]},{"color":"#c9ced3","id":"vent_hose","label":"Vent hose (behind dryer)","opacity":1.0,"position":[20,48,-60],"rotation":[25,0,12],"shape":"cylinder","size":[10,48,10]},{"color":"#202428","id":"leveling_feet","label":"Leveling feet (at four bottom corners)","opacity":1.0,"position":[0,2,0],"rotation":[0,0,0],"shape":"box","size":[64,4,58]},{"color":"#111417","id":"power_plug","label":"Power plug (behind dryer)","opacity":1.0,"position":[-8,32,-52],"rotation":[0,0,0],"shape":"box","size":[7,9,5]},{"color":"#969ea6","id":"home_breaker_box","label":"Home breaker box (two dryer breakers)","opacity":1.0,"position":[92,78,-52],"rotation":[0,-15,0],"shape":"box","size":[32,56,12]},{"color":"#3a7bd5","id":"water_inlet_hose","label":"Water inlet hose — steam models (behind dryer)","opacity":1.0,"position":[-24,56,-50],"rotation":[10,0,8],"shape":"cylinder","size":[2.5,40,2.5]}],"step_animations":[{"axis":"z","caption":"Pull lint screen out","distance":20,"motion":"pull_out","part_ids":["lint_screen","lint_screen_slot"],"step":0},{"axis":"y","caption":"Roll lint off screen","distance":0,"motion":"none","part_ids":["lint_screen"],"step":1},{"axis":"z","caption":"Push lint screen in","distance":20,"motion":"push_in","part_ids":["lint_screen","lint_screen_slot"],"step":2},{"axis":"z","caption":"Remove half the load","distance":30,"motion":"pull_out","part_ids":["dryer_drum","dryer_door"],"step":3},{"axis":"z","caption":"Turn knob to Normal","distance":2,"motion":"twist_cw","part_ids":["cycle_knob","control_panel"],"step":4},{"axis":"y","caption":"Check outside vent airflow","distance":0,"motion":"none","part_ids":["outside_vent_hood","vent_hose"],"step":5}]},"type":"model"}

