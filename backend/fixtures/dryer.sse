data: {"type": "plan", "plan": {"brand": "Whirlpool", "model_number": "WED5050LW", "appliance": "electric dryer", "manual_url": "https://www.whirlpool.com/owners-center-pdp.WED5050LW.html", "diagnosis": "Your lint screen is choking the airflow. Hot air has to pass through it to leave the drum, so a clogged screen traps moist air and the clothes stay damp. A blocked outside vent or an overfull drum does the same.", "tools": [], "replacement_parts": [], "safety": ["Clean the lint screen before every load.", "Do not run the dryer with the lint screen loose, damaged, or missing.", "If the vent inside the wall needs cleaning, have a qualified vent cleaner do it."], "steps": [{"instruction": "See where the hot air gets stuck", "details": ["Hot air leaves the drum through the lint screen.", "A full screen chokes it, so clothes stay damp."], "target_part": "Lint screen", "photo": -1, "motion": "none", "show_3d": true, "check": "You know the air has to get through the lint screen."}, {"instruction": "Pull the lint screen straight up", "details": ["It is on top of the dryer, near the back."], "target_part": "lint screen", "photo": -1, "motion": "pull_out", "show_3d": true, "check": "The lint screen is fully out of its slot."}, {"instruction": "Roll lint off screen with fingers", "details": ["Do not wash it for this quick clean.", "Wet lint is hard to remove."], "target_part": "lint screen", "photo": -1, "motion": "none", "show_3d": false, "check": "You can see through the screen clearly."}, {"instruction": "Push lint screen firmly back in", "details": ["Push until it sits flat and snug."], "target_part": "lint screen", "photo": -1, "motion": "push_in", "show_3d": true, "check": "The screen sits flat in its slot."}, {"instruction": "Take out half the load", "details": ["Clothes need room to tumble.", "Dry towels separately from light clothes."], "target_part": "dryer drum", "photo": -1, "motion": "pull_out", "show_3d": true, "check": "The drum is only about half to three-quarters full."}, {"instruction": "Run a short timed dry, feel the vent", "details": ["Set Timed Dry for 10 minutes and press Start.", "Go outside and hold your hand under the vent hood.", "Air should feel strong and warm, like a hair dryer."], "target_part": "Vent hose", "photo": -1, "motion": "none", "show_3d": true, "check": "Strong warm air blows out and the vent flap opens."}], "library_id": "whirlpool-electric-dryer", "library_problem": "clothes_still_damp_long_dry_time"}}

data: {"type": "rig", "rig": "dryer_top_vent", "step_beats": [[{"part": "air_path", "action": "look", "caption": "Lint blocks the hot air"}], [{"part": "lint_screen", "action": "remove", "caption": "Pull lint screen straight up"}], [{"part": "lint", "action": "clean", "caption": "Roll the lint off"}], [{"part": "lint_screen", "action": "insert", "caption": "Push it back down flat"}], [{"part": "dryer_door", "action": "open", "caption": "Open the door"}, {"part": "dryer_drum", "action": "look", "caption": "Leave it half full"}, {"part": "dryer_door", "action": "close", "caption": "Close the door"}], [{"part": "cycle_knob", "action": "turn", "caption": "Timed Dry, 10 minutes"}, {"part": "start_button", "action": "press", "caption": "Press and hold Start"}, {"part": "air_path", "action": "look", "caption": "Air flows freely now"}, {"part": "vent_hose", "action": "look", "caption": "Feel warm air outside"}]]}

