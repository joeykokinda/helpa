data: {"type": "plan", "plan": {"brand": "InSinkErator", "model_number": "Badger 5", "appliance": "garbage disposal", "manual_url": "https://www.insinkerator.com/documents/badger-series-installation-care-use-manual-english-en-us-138440.pdf", "diagnosis": "Something hard, like a bone, pit or spoon, is likely stuck inside and stopping the plate from turning. The unit shuts itself off to protect the motor, so clear the jam before turning it on again.", "tools": ["small jam wrench", "long tongs", "torch"], "replacement_parts": [], "safety": ["Turn the wall switch off before you start.", "Never put fingers or hands into the disposal.", "Take the jam wrench out before turning the power back on.", "Use tongs, never fingers, to pull anything out."], "steps": [{"instruction": "Turn the wall switch off", "details": ["Leave it off until the last step.", "Also turn the water off."], "target_part": "wall switch", "photo": -1, "motion": "press", "show_3d": false, "check": "The switch is off and the unit is silent."}, {"instruction": "Put jam wrench into bottom center hole", "details": ["Find the hole in the middle of the flat bottom.", "Push one end of the wrench firmly in."], "target_part": "center hole on the bottom", "photo": -1, "motion": "push_in", "show_3d": true, "check": "The wrench sits in the bottom hole and does not fall out."}, {"instruction": "Rock jam wrench back and forth gently", "details": ["Keep rocking until it turns one full turn.", "It may feel stiff at first, then loosen."], "target_part": "small jam wrench", "photo": -1, "motion": "none", "show_3d": true, "check": "The wrench now turns all the way around."}, {"instruction": "Pull jam wrench out again", "details": ["Never leave it in when you turn power on."], "target_part": "small jam wrench", "photo": -1, "motion": "pull_out", "show_3d": false, "check": "The wrench is out and in your hand."}, {"instruction": "Pull stuck food out with tongs", "details": ["Shine a torch down the drain to see it.", "Grip the stuck piece and lift it out."], "target_part": "spinning plate inside the drain", "photo": -1, "motion": "pull_out", "show_3d": true, "check": "You can see the stuck piece in the tongs."}, {"instruction": "Press red reset button underneath", "details": ["Wait 3 to 5 minutes first so it cools.", "Press lightly until it clicks and stays in."], "target_part": "red reset button", "photo": -1, "motion": "press", "show_3d": true, "check": "The red button stays in, not popped out."}, {"instruction": "Run cold water and test switch", "details": ["Turn cold water on first, then the switch.", "Let it run a few seconds after grinding stops."], "target_part": "wall switch", "photo": -1, "motion": "press", "show_3d": false, "check": "The unit spins freely and water drains away."}], "library_id": "garbage-disposal", "library_problem": "jammed_and_humming", "pro_visit_cost": 150, "aftercare": "Feed food in slowly with cold water running, and keep spoons and bones out of the sink."}}

