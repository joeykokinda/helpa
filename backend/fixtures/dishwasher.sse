data: {"type": "plan", "plan": {"brand": "Whirlpool", "model_number": "WDT730HAMZ", "appliance": "built-in dishwasher", "manual_url": "https://images.homedepot.ca/pdf/WDT540HAMZ_use_and_care-pdf.pdf", "diagnosis": "Water left behind often means food is blocking the floor filter or the sink drain. A little water around the filter can be normal.", "tools": ["cup", "bucket", "towel", "soft brush"], "replacement_parts": [], "safety": ["Turn off power at the breaker before reaching in water near parts.", "Do not pour drain cleaner into the dishwasher.", "Mop up spills so you do not slip."], "steps": [{"instruction": "Scoop water from bottom of the tub", "details": ["Use a cup and bucket.", "Put towels on the floor first."], "target_part": "bottom of the tub", "photo": -1, "motion": "none", "show_3d": true, "check": "Most standing water is out of the tub floor."}, {"instruction": "Twist the round top filter left and lift", "details": ["Turn it a quarter turn to the left.", "Lift out the flat filter too."], "target_part": "round top filter", "photo": -1, "motion": "twist_ccw", "show_3d": true, "check": "Both filters are out and you can see the tub floor."}, {"instruction": "Rinse the flat bottom filter under water", "details": ["Brush off food and grease gently.", "Pick out seeds or glass below it carefully."], "target_part": "flat bottom filter", "photo": -1, "motion": "rinse", "show_3d": false, "check": "The screen is clean and the hole below it is clear."}, {"instruction": "Pull food from the sink drain cap", "details": ["If you have this cap on your sink.", "Lift the cap and clear food under it."], "target_part": "sink drain cap", "photo": -1, "motion": "lift", "show_3d": true, "check": "The cap and the hole under it are clear of food."}, {"instruction": "Push the flat bottom filter down flat", "details": ["Seat it flat with no gaps."], "target_part": "flat bottom filter", "photo": -1, "motion": "push_in", "show_3d": true, "check": "The flat filter lies flat in the tub floor."}, {"instruction": "Twist the round top filter right", "details": ["Turn a quarter turn to the right.", "It should lock and not spin freely."], "target_part": "round top filter", "photo": -1, "motion": "twist_cw", "show_3d": true, "check": "The round filter is locked in place."}, {"instruction": "Press Start for a short rinse", "details": ["Close the door firmly first.", "Listen for water draining into the sink."], "target_part": "top edge buttons", "photo": -1, "motion": "press", "show_3d": false, "check": "Water drains away and only a little remains by the filter."}], "library_id": "whirlpool-dishwasher", "library_problem": "water_left_in_bottom"}}

data: {"type": "rig", "rig": "dishwasher", "step_beats": [[{"part": "door", "action": "open", "caption": "Open dishwasher door"}, {"part": "standing_water", "action": "look", "caption": "Look at standing water"}, {"part": "standing_water", "action": "clean", "caption": "Scoop out standing water"}], [{"part": "round_top_filter", "action": "unlock", "caption": "Twist filter left"}, {"part": "round_top_filter", "action": "remove", "caption": "Lift round filter out"}, {"part": "flat_bottom_filter", "action": "remove", "caption": "Lift flat filter out"}], [], [{"part": "sink_drain_cap", "action": "remove", "caption": "Lift sink drain cap"}, {"part": "air_gap_food", "action": "clean", "caption": "Clear food from cap"}, {"part": "sink_drain_cap", "action": "insert", "caption": "Replace sink drain cap"}], [{"part": "flat_bottom_filter", "action": "insert", "caption": "Seat flat filter flat"}], [{"part": "round_top_filter", "action": "insert", "caption": "Drop round filter in"}, {"part": "round_top_filter", "action": "lock", "caption": "Twist filter right"}], [{"part": "door", "action": "close", "caption": "Close the door"}, {"part": "start_button", "action": "press", "caption": "Start a short rinse"}, {"part": "rinse_water", "action": "open", "caption": "Fresh water fills the bottom"}, {"part": "rinse_water", "action": "close", "caption": "It drains away: fixed"}]]}

